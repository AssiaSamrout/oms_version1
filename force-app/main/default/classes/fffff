// ========== Discount Strategy Interface ==========
public interface IDiscountStrategy {
    Decimal calculateDiscount(order__c order, List<order_item__c> items, promotion__c promo);
}


// ========== Discount Strategy Implementations ==========
public class PercentageDiscountStrategy implements IDiscountStrategy {
    public Decimal calculateDiscount(order__c order, List<order_item__c> items, promotion__c promo) {
        Decimal base = (promo.RecordType.Name == 'order_level')
            ? order.SubTotal__c
            : getItemLevelTotal(items, promo.ProductId__c);

        if (promo.Percentage__c == null) {
            throw new IllegalArgumentException('Percentage is required');
        }
        return (base * promo.Percentage__c) / 100;
    }

    private Decimal getItemLevelTotal(List<order_item__c> items, Id productId) {
        Decimal total = 0;
        for (order_item__c item : items) {
            if (item.Product2Id__c == productId) {
                total += item.Unit_price__c * item.Quantity__c;
            }
        }
        return total;
    }
}

public class FixedDiscountStrategy implements IDiscountStrategy {
    public Decimal calculateDiscount(order__c order, List<order_item__c> items, promotion__c promo) {
        if (promo.DiscountValue__c == null || promo.DiscountValue__c < 0) {
            throw new IllegalArgumentException('Invalid fixed discount value');
        }
        return promo.DiscountValue__c;
    }
}


// ========== Discount Type Factory ==========
public class DiscountTypeFactory {
    public static IDiscountStrategy getDiscountStrategy(promotion__c promo) {
        if (promo.Type__c == 'Percentage') return new PercentageDiscountStrategy();
        if (promo.Type__c == 'Fixed amount') return new FixedDiscountStrategy();
        throw new PromoException('Unsupported discount type: ' + promo.Type__c);
    }
}


// ========== Adjustment Target Handlers ==========
public interface IAdjustmentTargetHandler {
    List<OrderAdjustment__c> applyAdjustment(order__c order, List<order_item__c> items, promotion__c promo, Decimal discount, Id couponId);
}

public class OrderLevelAdjustmentHandler implements IAdjustmentTargetHandler {
    public List<OrderAdjustment__c> applyAdjustment(order__c order, List<order_item__c> items, promotion__c promo, Decimal discount, Id couponId) {
        return new List<OrderAdjustment__c>{
            new OrderAdjustment__c(
                Order__c = order.Id,
                Promotion__c = promo.Id,
                Coupon__c = couponId,
                DiscountAmount__c = discount,
                RecordTypeId = RecordTypeUtil.getOrderLevelAdjustmentTypeId()
            )
        };
    }
}

public class ItemLevelAdjustmentHandler implements IAdjustmentTargetHandler {
    public List<OrderAdjustment__c> applyAdjustment(order__c order, List<order_item__c> items, promotion__c promo, Decimal discount, Id couponId) {
        List<OrderAdjustment__c> adjList = new List<OrderAdjustment__c>();
        for (order_item__c item : items) {
            if (item.Product2Id__c == promo.ProductId__c) {
                adjList.add(new OrderAdjustment__c(
                    Order__c = order.Id,
                    OrderItem__c = item.Id,
                    Promotion__c = promo.Id,
                    Coupon__c = couponId,
                    DiscountAmount__c = discount,
                    RecordTypeId = RecordTypeUtil.getItemLevelAdjustmentTypeId()
                ));
            }
        }
        return adjList;
    }
}


// ========== Target Handler Factory ==========
public class AdjustmentTargetHandlerFactory {
    public static IAdjustmentTargetHandler getHandler(promotion__c promo) {
        if (promo.RecordType.Name == 'order_level') return new OrderLevelAdjustmentHandler();
        if (promo.RecordType.Name == 'item_level') return new ItemLevelAdjustmentHandler();
        throw new PromoException('Unknown promotion level: ' + promo.RecordType.Name);
    }
}


// ========== Post Checkout Processor ==========
public with sharing class PostCheckoutDiscountProcessor {
    public static OrderDiscountProcessingResult processDiscounts(Id orderId, List<String> couponCodes) {
        Savepoint sp = Database.setSavepoint();
        OrderDiscountProcessingResult result = new OrderDiscountProcessingResult();

        try {
            order__c order = OrderService.getOrderById(orderId);
            List<order_item__c> items = [
                SELECT Id, Unit_price__c, Quantity__c, Product2Id__c FROM order_item__c WHERE order__c = :orderId
            ];

            List<OrderAdjustment__c> allAdjustments = new List<OrderAdjustment__c>();
            List<promotion__c> appliedPromotions = new List<promotion__c>();

            List<coupon__c> coupons = CouponService.getCouponsByCouponCodes(couponCodes);
            for (coupon__c coupon : coupons) {
                if (!CouponService.validateCoupon(coupon)) continue;

                promotion__c promo = PromotionService.getPromotionById(coupon.PromotionId__c);
                if (promo == null || !PromotionService.isEligible(order, items, promo).isEligible) continue;

                Decimal discount = DiscountTypeFactory.getDiscountStrategy(promo).calculateDiscount(order, items, promo);
                List<OrderAdjustment__c> adjustments = AdjustmentTargetHandlerFactory.getHandler(promo)
                    .applyAdjustment(order, items, promo, discount, coupon.Id);

                allAdjustments.addAll(adjustments);
                appliedPromotions.add(promo);
                CouponService.incrementUsageCount(coupon);
            }

            List<promotion__c> autoPromos = PromotionService.getAutoApplicablePromotions();
            for (promotion__c promo : autoPromos) {
                if (!PromotionService.isEligible(order, items, promo).isEligible) continue;

                Decimal discount = DiscountTypeFactory.getDiscountStrategy(promo).calculateDiscount(order, items, promo);
                List<OrderAdjustment__c> adjustments = AdjustmentTargetHandlerFactory.getHandler(promo)
                    .applyAdjustment(order, items, promo, discount, null);

                allAdjustments.addAll(adjustments);
                appliedPromotions.add(promo);
            }

            if (!allAdjustments.isEmpty()) insert allAdjustments;

            Decimal newTotal = OrderAdjustmentService.recalculateOrderTotal(items, allAdjustments);
            order.Total_Amount__c = newTotal;
            update order;

            result.success = true;
            result.appliedPromotions = appliedPromotions;
            result.totalDiscount = OrderAdjustmentService.calculateTotalDiscount(allAdjustments);
            result.newOrderTotal = newTotal;

        } catch (Exception e) {
            Database.rollback(sp);
            result.success = false;
            result.errorMessage = e.getMessage();
        }

        return result;
    }
}
